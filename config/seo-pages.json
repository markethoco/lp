{
  "origin": "https://marketho.co",
  "defaults": {
    "robots": "index, follow",
    "ogType": "website",
    "schemaType": "WebPage",
    "language": "es-CO",
    "ogLocale": "es_CO",
    "timezone": "America/Bogota",
    "schemaDefaults": {
      "inLanguage": "es-CO",
      "addressCountry": "CO"
    }
  },
  "excludedFromSitemap": [
    "/gracias/",
    "/privacidad/",
    "/publicidad-digital/",
    "/publicidad-digital/privacidad/",
    "/servicios/"
  ],
  "pages": {
    "/publicidad-digital/": {
      "robots": "noindex, nofollow",
      "status": "approved-preview"
    }
  }
}
